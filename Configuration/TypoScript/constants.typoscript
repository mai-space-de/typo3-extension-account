plugin.tx_maiaccount {
    view {
        # cat=plugin.tx_maiaccount/file; type=string; label=Path to template root (BE)
        templateRootPath =
        # cat=plugin.tx_maiaccount/file; type=string; label=Path to template partials (BE)
        partialRootPath =
        # cat=plugin.tx_maiaccount/file; type=string; label=Path to template layouts (BE)
        layoutRootPath =
    }

    persistence {
        # cat=plugin.tx_maiaccount/db; type=int+; label=Default storage PID for fe_users
        storagePid = 0
    }

    settings {
        # cat=plugin.tx_maiaccount/fe; type=int+; label=Default fe_group UID for new users
        defaultUserGroup = 0

        # cat=plugin.tx_maiaccount/fe; type=string; label=Issuer name shown in TOTP apps
        mfaIssuer = maispace

        # cat=plugin.tx_maiaccount/fe; type=int+; label=Page UID of terms & conditions page
        termsPage = 0
    }
}
