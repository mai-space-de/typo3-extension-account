{
    "name": "maispace/mai-account",
    "description": "TYPO3 FE-User extension: Login, Registration, MFA, Profile management with interests, newsletter opt-in, reminders and member reference",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "maispace",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "typo3/cms-core": "^12.4",
        "typo3/cms-extbase": "^12.4",
        "typo3/cms-fluid": "^12.4",
        "typo3/cms-frontend": "^12.4",
        "typo3/cms-scheduler": "^12.4",
        "spomky-labs/otphp": "^11.0",
        "paragonie/constant_time_encoding": "^2.0"
    },
    "require-dev": {
        "typo3/testing-framework": "^8.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Maispace\\MaiAccount\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Maispace\\MaiAccount\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "mai_account"
        }
    },
    "config": {
        "allow-plugins": {
            "typo3/cms-composer-installers": true,
            "typo3/class-alias-loader": true
        }
    }
}
